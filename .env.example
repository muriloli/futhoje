# Copie este arquivo para ".env" e preencha com os dados do seu banco Turso.
# Sem estas variáveis, o app usa um arquivo SQLite local (quadra.db) automaticamente.

# URL do banco (começa com libsql://)
TURSO_DATABASE_URL=

# Token de autenticação gerado no Turso
TURSO_AUTH_TOKEN=

# Senha de editor (quem tem essa senha pode alterar dados; sem ela, só leitura)
ADMIN_PASSWORD=
